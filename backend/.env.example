# app
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
TRUST_PROXY=false
# only needed if the browser calls the api directly
TRUSTED_ORIGINS=http://localhost:3000

# database
DATABASE_URL=postgresql://coy:coy@localhost:5441/coy
TEST_DATABASE_URL=postgresql://coy:coy@localhost:5441/coy_test

# no auth, all requests act as this user
CURRENT_USER_ID=00000000-0000-4000-8000-000000000001

# "Start over" button in the demo, not allowed in production
DEMO_RESET_ENABLED=true
